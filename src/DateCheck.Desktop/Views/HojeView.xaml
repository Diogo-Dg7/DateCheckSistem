<UserControl x:Class="DateCheck.Desktop.Views.HojeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DateCheck.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HojeViewModel}">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho: dia exibido e navegação -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Titulo}" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitulo}" Foreground="{StaticResource TextoSecundario}" FontSize="14" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="◀" ToolTip="Dia anterior" Command="{Binding DiaAnteriorCommand}"
                        Style="{StaticResource BotaoPequeno}" />
                <Button Content="Hoje" Command="{Binding VoltarParaHojeCommand}" Style="{StaticResource BotaoPequeno}" />
                <Button Content="▶" ToolTip="Próximo dia" Command="{Binding DiaSeguinteCommand}"
                        Style="{StaticResource BotaoPequeno}" />
                <Button Content="Calendário" Command="{Binding IrParaCalendarioCommand}"
                        Style="{StaticResource BotaoPequeno}" Margin="12,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Lista de compromissos -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Itens}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AgendamentoItemViewModel}">
                        <Border x:Name="Cartao" Margin="0,0,0,10" CornerRadius="6" BorderThickness="1"
                                BorderBrush="#E5E7EB" Background="White">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Atrasado}" Value="True">
                                            <Setter Property="Background" Value="#FEF2F2" />
                                            <Setter Property="BorderBrush" Value="#FCA5A5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Proximo}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Destaque}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EstaCancelado}" Value="True">
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{Binding Status, Converter={StaticResource StatusParaCor}}"
                                        CornerRadius="5,0,0,5" />

                                <StackPanel Grid.Column="1" Margin="14,10,10,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Titulo}" FontSize="16" FontWeight="SemiBold"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstaCancelado}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border CornerRadius="9" Padding="8,1" Margin="10,2,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding TemMarcador, Converter={StaticResource BoolParaVisibilidade}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Alerta}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Proximo}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Destaque}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Marcador}" Foreground="White" FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextoSecundario}">
                                        <Run Text="{Binding Horario, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding StatusTexto, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock Text="{Binding Descricao}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding TemDescricao, Converter={StaticResource BoolParaVisibilidade}}" />
                                </StackPanel>

                                <WrapPanel Grid.Column="2" Margin="0,10,10,10" VerticalAlignment="Center"
                                           MaxWidth="260" HorizontalAlignment="Right">
                                    <Button Content="Concluir" Style="{StaticResource BotaoPequeno}"
                                            Command="{Binding DataContext.ConcluirCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding PodeConcluir, Converter={StaticResource BoolParaVisibilidade}}" />
                                    <Button Content="Cancelar" Style="{StaticResource BotaoPequeno}"
                                            Command="{Binding DataContext.CancelarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding PodeCancelar, Converter={StaticResource BoolParaVisibilidade}}" />
                                    <Button Content="Reabrir" Style="{StaticResource BotaoPequeno}"
                                            Command="{Binding DataContext.ReabrirCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding PodeReabrir, Converter={StaticResource BoolParaVisibilidade}}" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Text="Nenhum compromisso neste dia." HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="16" Foreground="{StaticResource TextoSecundario}"
                   Visibility="{Binding EstaVazio, Converter={StaticResource BoolParaVisibilidade}}" />
    </Grid>
</UserControl>
