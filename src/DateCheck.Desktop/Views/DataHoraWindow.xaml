<Window x:Class="DateCheck.Desktop.Views.DataHoraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DateCheck.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DataHoraViewModel}"
        Title="{Binding TituloDaJanela}" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,16,24,20">
        <TextBlock Text="{Binding Rotulo}" Margin="0,0,0,10" TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <DatePicker Grid.Column="0" SelectedDate="{Binding Data}" />
            <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding Hora, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="5" ToolTip="Formato HH:mm" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancelar" IsCancel="True" Command="{Binding CancelarCommand}" MinWidth="90" Margin="0,0,8,0" />
            <Button Content="OK" IsDefault="True" Command="{Binding ConfirmarCommand}" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
