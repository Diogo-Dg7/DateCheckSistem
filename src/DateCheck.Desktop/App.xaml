<Application x:Class="DateCheck.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DateCheck.Desktop.Conversores"
             ThemeMode="Light">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <conv:StatusParaCorConverter x:Key="StatusParaCor" />

        <SolidColorBrush x:Key="TextoSecundario" Color="#6B7280" />
        <SolidColorBrush x:Key="Destaque" Color="#2563EB" />
        <SolidColorBrush x:Key="Alerta" Color="#DC2626" />

        <Style x:Key="BotaoPequeno" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Application.Resources>
</Application>
