<Window x:Class="DateCheck.Desktop.Views.AgendamentoFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DateCheck.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AgendamentoFormViewModel}"
        Title="{Binding TituloDaJanela}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Rotulo">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Foreground" Value="{StaticResource TextoSecundario}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,16,24,20">
        <TextBlock Text="Título" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
        <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />

        <TextBlock Text="Descrição" Style="{StaticResource Rotulo}" />
        <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120"
                 VerticalScrollBarVisibility="Auto" />

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Início" Style="{StaticResource Rotulo}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Hora" Style="{StaticResource Rotulo}" Margin="8,10,0,4" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="Fim" Style="{StaticResource Rotulo}" />
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Hora" Style="{StaticResource Rotulo}" Margin="8,10,0,4" />

            <DatePicker Grid.Row="1" Grid.Column="0" SelectedDate="{Binding DataInicio}" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Text="{Binding HoraInicio, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="5" ToolTip="Formato HH:mm" />
            <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding DataFim}" />
            <TextBox Grid.Row="1" Grid.Column="4" Margin="8,0,0,0" Text="{Binding HoraFim, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="5" ToolTip="Formato HH:mm" />
        </Grid>

        <Separator Margin="0,18,0,8" />

        <CheckBox Content="Repetir este compromisso" IsChecked="{Binding Repetir}" />

        <Grid Margin="0,8,0,0" Visibility="{Binding Repetir, Converter={StaticResource BoolParaVisibilidade}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ComboBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,8"
                      ItemsSource="{x:Static vm:AgendamentoFormViewModel.Frequencias}"
                      DisplayMemberPath="Texto" SelectedValuePath="Valor"
                      SelectedValue="{Binding Frequencia}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="A cada" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Intervalo, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding UnidadeDoIntervalo}" VerticalAlignment="Center"
                       Margin="8,0,16,0" />
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                <TextBlock Text="até" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding RepetirAte}" MinWidth="140" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancelar" IsCancel="True" Command="{Binding CancelarCommand}" MinWidth="90" Margin="0,0,8,0" />
            <Button Content="Salvar" IsDefault="True" Command="{Binding SalvarCommand}" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
